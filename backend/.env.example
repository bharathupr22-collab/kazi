ENVIRONMENT=development
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=kazi
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_NAME=kazi_session
# Must be true behind HTTPS in production. Use the Next same-origin /api proxy.
COOKIE_SECURE=false
SESSION_HOURS=168
RESET_MINUTES=30
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
AI_RATE_LIMIT=20

# Server-only. Without a key AI endpoints return 503, never synthetic results.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

# SMTP required for password resets; tokens are sent only by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
